HOST: 0.0.0.0
PORT: 8080
DATA_DIR: ./data
LOG_LEVEL: INFO
LOG_FORMAT: text
COOKIE_SECURE: false
COOKIE_SAMESITE: lax
SESSION_MAX_AGE_SECONDS: 86400
DATABASE_URL: null # defaults to sqlite:////data/database.db in Docker
WEB_ROOT: null
AUTO_MIGRATE: true
ADMIN_SECRET: null
MASTER_KEY: null
EVENT_QUEUE_SIZE: 10000
GLOBAL_MAX_CONCURRENCY: 2000
MAX_REQUEST_BODY_BYTES: 10485760
UPSTREAM_MAX_CONNECTIONS: 2000
UPSTREAM_MAX_KEEPALIVE_CONNECTIONS: 500
USAGE_CHECK_CONCURRENCY: 10
