TAVILY_MUX_HOST=0.0.0.0
TAVILY_MUX_PORT=8080
TAVILY_MUX_DATA_DIR=./data
# TAVILY_MUX_DATABASE_URL=sqlite:////absolute/path/database.db
# TAVILY_MUX_WEB_ROOT=/absolute/path/to/web
TAVILY_MUX_AUTO_MIGRATE=true
TAVILY_MUX_LOG_LEVEL=INFO
TAVILY_MUX_LOG_FORMAT=text
TAVILY_MUX_ACCESS_LOG=false
TAVILY_MUX_ADMIN_SECRET=
TAVILY_MUX_MASTER_KEY=
TAVILY_MUX_COOKIE_SECURE=false
TAVILY_MUX_COOKIE_SAMESITE=lax
TAVILY_MUX_SESSION_MAX_AGE_SECONDS=86400
TAVILY_MUX_EVENT_QUEUE_SIZE=10000
TAVILY_MUX_GLOBAL_MAX_CONCURRENCY=2000
TAVILY_MUX_MAX_REQUEST_BODY_BYTES=10485760
TAVILY_MUX_UPSTREAM_MAX_CONNECTIONS=2000
TAVILY_MUX_UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=500
TAVILY_MUX_USAGE_CHECK_CONCURRENCY=10
# ENDPOINTS.disabled values: search, extract, crawl, map, research, feedback.
# Disabling research disables both POST /research and GET /research/{request_id}.
TAVILY_MUX_ENDPOINTS={"disabled":[],"custom":[]}
TAVILY_MUX_CONFIG_FILE=./config.yaml
